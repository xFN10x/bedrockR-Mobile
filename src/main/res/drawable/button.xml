<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="0">
    <item android:state_pressed="true" android:state_enabled="true">
        <shape >
            <solid android:color="@color/background" />
            <stroke android:width="5dp" android:color="@color/accentColor" />
        </shape>
    </item>

    <item android:state_pressed="false" android:state_enabled="true">
        <shape >
            <solid android:color="@color/background" />
            <stroke android:width="3dp" android:color="@color/cardview_dark_background" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape >
            <solid android:color="@color/darkAccentColor" />
            <stroke android:width="2dp" android:color="@color/cardview_dark_background" />
        </shape>
    </item>
</selector>